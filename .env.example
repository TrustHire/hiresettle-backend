# Engagement auto-cancel configuration
# Number of days an unfunded draft engagement may remain open before it is auto-cancelled.
ENGAGEMENT_UNFUNDED_CANCEL_DAYS=14
# Hours before the cancellation deadline that the engagement owner is warned.
ENGAGEMENT_UNFUNDED_WARN_HOURS=48

# Dispute workflow (#381, #382)
# Hours after a dispute decision during which either party may appeal; funds stay in escrow until then.
# Set to 0 to settle decisions immediately (disables appeals).
DISPUTE_APPEAL_WINDOW_HOURS=72
# SLA response deadlines per dispute stage, in hours. Overdue disputes are escalated to admins.
DISPUTE_SLA_ASSIGNMENT_HOURS=24
DISPUTE_SLA_REVIEW_HOURS=72
DISPUTE_SLA_APPEAL_HOURS=72

# Horizon endpoint failover
# Comma-separated list of Horizon base URLs, tried in order.
# The first URL is the primary; the service fails over to the next after
# HORIZON_FAILOVER_THRESHOLD consecutive errors and probes for recovery every
# HORIZON_RECOVERY_INTERVAL_MS milliseconds.
# If unset, STELLAR_HORIZON_URL (or the network default) is used as the sole endpoint.
HORIZON_URLS=https://horizon.stellar.org,https://horizon-testnet.stellar.org
HORIZON_FAILOVER_THRESHOLD=3
HORIZON_RECOVERY_INTERVAL_MS=60000
