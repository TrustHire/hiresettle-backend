// prisma/schema.prisma
// HireSettle — Database schema
// Run: npx prisma migrate dev --name init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================
// ENUMS — mirror the on-chain contract enums
// ============================================================

enum EngagementStatus {
  ACTIVE
  COMPLETED
  CANCELLED
  REPLACEMENT_REQUESTED
  ACCOUNT_MERGED
}

enum MilestoneStatus {
  LOCKED
  PENDING
  PROOF_SUBMITTED
  CONFIRMED
  DISPUTED
  RESOLVED
}

enum MilestoneKind {
  PLACEMENT
  RETENTION
}

enum NotificationType {
  ENGAGEMENT_CREATED
  MILESTONE_UNLOCKED
  PROOF_SUBMITTED
  MILESTONE_CONFIRMED
  DISPUTE_RAISED
  DISPUTE_RESOLVED
  REPLACEMENT_REQUESTED
  ENGAGEMENT_CANCELLED
  PAYMENT_RELEASED
  RETENTION_WINDOW_APPROACHING
  ARBITER_ASSIGNED
  ARBITER_REASSIGNED
  ARBITER_RECUSAL_REQUESTED
  ACCOUNT_MERGE_DETECTED
  FUNDING_SHORTFALL_DETECTED
  STELLAR_BALANCE_LOW
}

enum UserRole {
  COMPANY
  RECRUITER
  ARBITER
  ADMIN
}

enum SecurityEventAction {
  LOGIN_SUCCESS
  LOGIN_FAILURE
  LOGOUT
  PASSWORD_RESET
  EMAIL_VERIFICATION
  ROLE_CHANGE
  ADMIN_OVERRIDE
  IMPERSONATION_ISSUED
}

// ============================================================
// MODELS
// ============================================================

model User {
  id             String    @id @default(uuid())
  stellarAddress String?   @unique
  email          String?   @unique
  passwordHash   String?
  name           String?
  company        String?        // company name (for COMPANY role users)
  role           UserRole       @default(COMPANY)
  webhookUrl     String?
  webhookSecret  String?        // HMAC-SHA256 signing secret, generated when webhookUrl is first set
  rateLimitOverride Int?        // custom per-user request limit for UserJwtSubThrottlerGuard; falls back to default when unset
  avatarUrl      String?        // CDN URL for user avatar
  verifiedAt     DateTime?      // Set by an admin after company verification
  deactivatedAt  DateTime?
  failedLoginAttempts Int       @default(0)
  lockedUntil    DateTime?
  totpSecret     String?        // TOTP secret for 2FA
  totpEnabled    Boolean         @default(false)
  googleId       String?   @unique // Google OAuth subject; linked by email when an account already exists
  deletedAt      DateTime?      // GDPR anonymisation timestamp — set when erasure is requested
  anonymizedAt   DateTime?      // Set by PiiAnonymizationSchedulerService once all PII fields are wiped
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  // Relations
  companyEngagements   Engagement[]            @relation("CompanyEngagements")
  recruiterEngagements Engagement[]            @relation("RecruiterEngagements")
  arbiterEngagements   Engagement[]            @relation("ArbiterEngagements")
  notifications        Notification[]
  refreshTokens        RefreshToken[]
  notificationPrefs    NotificationPreference[]
  milestoneAuditLogs   MilestoneAuditLog[]
  disputeEvidences     DisputeEvidence[]
  auditLogs            EngagementAuditLog[]
  securityEvents       SecurityEvent[]
  securityEventsAsActor SecurityEvent[] @relation("SecurityEventActor")
  securityEventsAsTarget SecurityEvent[] @relation("SecurityEventTarget")
  engagementTemplates  EngagementTemplate[]
  idempotencyKeys      IdempotencyKey[]
  webhookDeliveries    WebhookDelivery[]
  engagementNotes      EngagementNote[]
  apiKeys              ApiKey[]

  @@index([role, deactivatedAt])
  @@index([deletedAt, anonymizedAt]) // Used by PiiAnonymizationSchedulerService
  @@map("users")
}

// Server-to-server credentials. Raw key is shown once at creation; only keyHash is stored.
model ApiKey {
  id         String    @id @default(uuid())
  name       String
  keyPrefix  String    // first 8 chars of the raw key for display/lookup hints
  keyHash    String    @unique
  userId     String    // owning user (usually a COMPANY account)
  companyId  String?   // optional company scope (defaults to userId for COMPANY users)
  expiresAt  DateTime?
  revokedAt  DateTime?
  lastUsedAt DateTime?
  createdAt  DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([companyId])
  @@index([keyHash])
  @@map("api_keys")
}

model RefreshToken {
  id         String    @id @default(uuid())
  userId     String
  tokenHash  String    @unique
  familyId   String
  expiresAt  DateTime
  consumedAt DateTime?
  revokedAt  DateTime?
  createdAt  DateTime  @default(now())

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([familyId])
  @@index([expiresAt])
  @@map("refresh_tokens")
}

model Engagement {
  id               String            @id     // matches on-chain engagement_id
  companyAddress   String
  recruiterAddress String
  arbiterAddress   String
  companyId        String?
  recruiterId      String?
  arbiterId        String?
  clientId         String?
  freelancerId     String?
  tokenAddress     String
  totalAmount      BigInt            // total fee in stroops
  releasedAmount   BigInt            @default(0)
  fundingShortfall Boolean           @default(false)
  escrowBalance    BigInt?
  jobTitle         String
  jobDescription   String?           // off-chain — not stored on-chain
  salaryRange      String?           // off-chain metadata
  location         String?           // off-chain metadata
  status           EngagementStatus  @default(ACTIVE)
  replacementReason String?
  txHash           String?           // on-chain creation tx hash
  createdLedger    Int?              // ledger sequence at creation
  templateVersionId String?          // specific EngagementTemplateVersion used to create this engagement, if any
  archivedAt       DateTime?         // soft-archive timestamp — excluded from default list views
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  // Relations
  company         User                        @relation("CompanyEngagements",   fields: [companyAddress],   references: [stellarAddress])
  recruiter       User                        @relation("RecruiterEngagements", fields: [recruiterAddress], references: [stellarAddress])
  arbiter         User                        @relation("ArbiterEngagements",   fields: [arbiterAddress],   references: [stellarAddress])
  templateVersion EngagementTemplateVersion?  @relation(fields: [templateVersionId], references: [id])
  milestones      Milestone[]
  events          ChainEvent[]
  auditLogs       EngagementAuditLog[]
  notes           EngagementNote[]

  @@index([status])
  @@index([companyAddress])
  @@index([recruiterAddress])
  @@index([status, createdAt])
  @@index([archivedAt])
  @@map("engagements")
}

// Internal notes left by either party on an engagement (visible to both).
// Not to be confused with milestone proof text — these are free-form comments.
model EngagementNote {
  id           String   @id @default(uuid())
  engagementId String
  authorId     String
  body         String
  createdAt    DateTime @default(now())

  engagement Engagement @relation(fields: [engagementId], references: [id])
  author     User       @relation(fields: [authorId], references: [id])

  @@index([engagementId])
  @@map("engagement_notes")
}

model EngagementAuditLog {
  id           String   @id @default(cuid())
  engagementId String
  fromStatus   String
  toStatus     String
  changedBy    String
  reason       String?
  createdAt    DateTime @default(now())

  engagement   Engagement @relation(fields: [engagementId], references: [id])
  changedByUser User       @relation(fields: [changedBy], references: [id])

  @@index([engagementId])
  @@index([changedBy])
}

model Milestone {
  id               String          @id @default(uuid())
  engagementId     String
  milestoneIndex   Int             // 0-based index matching on-chain
  name             String
  kind             MilestoneKind
  paymentPercent   Int             // 0-100
  amount           BigInt?
  retentionDays    Int?            // original retention window in days (for display)
  validAfterLedger Int?            // on-chain valid_after_ledger value
  unlockEstimatedAt DateTime?      // estimated real-world datetime of unlock
  proofHash        String?
  disputeReason    String?
  approachingNotificationSent Boolean @default(false)
  status           MilestoneStatus @default(PENDING)
  paymentReleased  BigInt?
  confirmedAt      DateTime?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  // Relations
  engagement         Engagement          @relation(fields: [engagementId], references: [id])
  milestoneAuditLogs MilestoneAuditLog[]
  disputeEvidences   DisputeEvidence[]

  @@unique([engagementId, milestoneIndex])
  @@index([status])
  @@index([engagementId])
  @@index([status, engagementId])
  @@map("milestones")
}

model ChainEvent {
  id           String    @id @default(uuid())
  engagementId String?
  eventName    String    // e.g. "engagement_created", "milestone_confirmed"
  ledger       Int
  txHash       String
  payload      Json
  processed    Boolean   @default(false)
  retryCount   Int       @default(0)
  lastErrorAt  DateTime?
  createdAt    DateTime  @default(now())

  // Relations
  engagement Engagement? @relation(fields: [engagementId], references: [id])

  @@index([engagementId])
  @@index([eventName])
  @@index([processed])
  @@map("chain_events")
}

model SystemConfig {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt

  @@map("system_config")
}

enum WebhookDeliveryStatus {
  FAILED
  RESENT
}

// Webhook subscriptions managed per-company via the API.
model WebhookSubscription {
  id        String   @id @default(uuid())
  companyId String
  url       String
  createdAt DateTime @default(now())

  @@index([companyId])
  @@map("webhook_subscriptions")
}

// Recorded when a webhook job exhausts its retry attempts, so failures are
// tracked instead of silently dropped. Admins can resend from here.
model WebhookDelivery {
  id           String                @id @default(uuid())
  userId       String?
  url          String
  event        String
  payload      Json
  attempts     Int
  errorMessage String?
  status       WebhookDeliveryStatus @default(FAILED)
  resendCount  Int                   @default(0)
  lastResendAt DateTime?
  createdAt    DateTime              @default(now())
  updatedAt    DateTime              @updatedAt

  user User? @relation(fields: [userId], references: [id])

  @@index([status])
  @@index([userId])
  @@map("webhook_deliveries")
}

model DeadLetterEvent {
  id           String    @id @default(uuid())
  originalId   String    @unique
  engagementId String?
  eventName    String
  ledger       Int
  txHash       String
  payload      Json
  retryCount   Int       @default(0)
  lastErrorAt  DateTime?
  errorMessage String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([eventName])
  @@index([engagementId])
  @@map("dead_letter_events")
}

model NotificationPreference {
  id           String           @id @default(uuid())
  userId       String
  type         NotificationType
  emailEnabled Boolean          @default(true)
  inAppEnabled Boolean          @default(true)
  sseEnabled   Boolean          @default(true)

  user User @relation(fields: [userId], references: [id])

  @@unique([userId, type])
  @@index([userId])
  @@map("notification_preferences")
}

model Notification {
  id        String           @id @default(uuid())
  userId    String
  type      NotificationType
  title     String
  message   String
  data      Json?
  read      Boolean          @default(false)
  emailSent Boolean          @default(false)
  createdAt DateTime         @default(now())

  // Relations
  user User @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([read])
  @@map("notifications")
}

model EngagementTemplate {
  id              String   @id @default(uuid())
  companyId       String
  name            String
  jobTitle        String
  jobDescription  String?
  salaryRange     String?
  location        String?
  milestoneConfig Json
  currentVersion  Int      @default(1)
  archived        Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  company  User                        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  versions EngagementTemplateVersion[]

  @@index([companyId])
  @@map("engagement_templates")
}

// Immutable snapshot of an EngagementTemplate's fields at a point in time.
// Created on every template update so past engagements keep referencing
// the exact template content they were created with.
model EngagementTemplateVersion {
  id              String   @id @default(uuid())
  templateId      String
  version         Int
  name            String
  jobTitle        String
  jobDescription  String?
  salaryRange     String?
  location        String?
  milestoneConfig Json
  createdAt       DateTime @default(now())

  template    EngagementTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  engagements Engagement[]

  @@unique([templateId, version])
  @@index([templateId])
  @@map("engagement_template_versions")
}

model AuditLog {
  id          String    @id @default(uuid())
  entityType  String    // e.g., "Engagement", "Milestone"
  entityId    String
  action      String    // e.g., "STATUS_OVERRIDE"
  oldValue    String?
  newValue    String
  reason      String
  changedBy   String    // userId of the admin who made the change
  createdAt   DateTime  @default(now())

  @@index([entityType, entityId])
  @@index([changedBy])
  @@map("audit_logs")
}

// Tracks retention milestones that need to be unlocked.
// The RetentionSchedulerService queries this table every hour.
model RetentionSchedule {
  id               String   @id @default(uuid())
  engagementId     String
  milestoneIndex   Int
  validAfterLedger Int      // on-chain ledger to unlock at
  unlockAt         DateTime // estimated wall-clock time (for cron scheduling)
  notifyAt         DateTime // 3 days before unlock (send "approaching" notification)
  unlocked         Boolean  @default(false)
  notified         Boolean  @default(false)
  createdAt        DateTime @default(now())

  @@unique([engagementId, milestoneIndex])
  @@index([unlockAt])
  @@index([notifyAt])
  @@index([unlocked])
  @@map("retention_schedules")
}

model MilestoneAuditLog {
  id          String        @id @default(uuid())
  milestoneId String
  fromStatus  MilestoneStatus
  toStatus    MilestoneStatus
  changedBy   String
  createdAt   DateTime      @default(now())

  milestone   Milestone     @relation(fields: [milestoneId], references: [id])
  user        User          @relation(fields: [changedBy], references: [id])

  @@index([milestoneId])
  @@index([changedBy])
  @@map("milestone_audit_logs")
}

model DisputeEvidence {
  id          String    @id @default(uuid())
  milestoneId String
  uploadedBy  String
  fileName    String
  fileSize    Int       // in bytes
  mimeType    String
  s3Path      String    // path in S3 bucket
  s3Url       String?   // presigned URL (optional, can be generated on the fly)
  uploadedAt  DateTime  @default(now())

  milestone   Milestone @relation(fields: [milestoneId], references: [id], onDelete: Cascade)
  user        User      @relation(fields: [uploadedBy], references: [id])

  @@index([milestoneId])
  @@index([uploadedBy])
  @@map("dispute_evidence")
}

// GDPR right-to-erasure queue. Created when a user requests account deletion.
// Admins review and process via POST /admin/data-deletion-requests/:id/process.
model DataDeletionRequest {
  id          String    @id @default(uuid())
  userId      String
  requestedAt DateTime  @default(now())
  processedAt DateTime?
  processedBy String?   // admin userId

  @@index([processedAt])
  @@map("data_deletion_requests")
}

// Append-only log of security-relevant events for incident response and
// compliance. No update or delete endpoints are exposed for this table.
model SecurityEvent {
  id         String              @id @default(uuid())
  userId     String?
  actorId    String?
  targetUserId String?
  action     SecurityEventAction
  ip         String?
  userAgent  String?
  createdAt  DateTime            @default(now())

  user       User? @relation(fields: [userId], references: [id], onDelete: SetNull)
  actor      User? @relation("SecurityEventActor", fields: [actorId], references: [id], onDelete: SetNull)
  targetUser User? @relation("SecurityEventTarget", fields: [targetUserId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([actorId])
  @@index([targetUserId])
  @@index([action])
  @@index([createdAt])
  @@map("security_events")
}

// Caches responses for requests submitted with an Idempotency-Key header so
// retried requests (e.g. after a network failure) return the original
// response instead of creating a duplicate record.
model IdempotencyKey {
  id        String   @id @default(uuid())
  key       String
  userId    String
  response  Json
  createdAt DateTime @default(now())
  expiresAt DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([key, userId])
  @@index([expiresAt])
  @@map("idempotency_keys")
}
